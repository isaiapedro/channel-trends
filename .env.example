# Public YouTube Data API v3 credential. Keep the real value in ignored .env.
YOUTUBE_API_KEY=replace_with_authorized_key

# Must be a loopback HTTP URL. Local Ollama must serve nomic-embed-text and llama3.2.
OLLAMA_HOST=http://127.0.0.1:11434

# Bounded external-request behavior.
TRENDS_HTTP_TIMEOUT_SECONDS=30
TRENDS_GOOGLE_RETRIES=3
TRENDS_GOOGLE_BACKOFF_SECONDS=5
